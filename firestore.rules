rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Master Admin UID Check
    function isMasterAdmin() {
      return request.auth != null && (request.auth.uid == 'kcca315tMqYP22OeU8VBECh4VRq2' || request.auth.uid == 'jmWcMuiYJdaGzr8nRiIc2jPbX6H3');
    }

    // Orders Collection
    match /orders/{orderId} {
      // Storefront customers can create orders
      allow create: if true;
      // ONLY Master Admin can read, update shipping/status, or delete orders
      allow read, update, delete: if isMasterAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // All other collections locked strictly to Master Admin
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }
  }
}
