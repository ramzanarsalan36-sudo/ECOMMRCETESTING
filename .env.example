# -------------------------------------------------------
# 1. ADMIN PANEL CREDENTIALS (Secure ID & Password)
# -------------------------------------------------------
# Use a strong username and password for production admin access.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Hopekraft@Secure2026!
ADMIN_JWT_SECRET=hopekraft_super_secure_jwt_secret_key_change_in_production_8943275923

# -------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY
# -------------------------------------------------------
# Get your Key ID and Secret from: https://dashboard.razorpay.com/#/app/keys
# (In test mode, keys start with 'rzp_test_...', in live mode 'rzp_live_...')
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_hopekraft12345
RAZORPAY_KEY_ID=rzp_test_hopekraft12345
RAZORPAY_KEY_SECRET=hopekraft_razorpay_mock_secret_key_9999
# Optional: Webhook Secret if you configure Webhooks in Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=

# -------------------------------------------------------
# 3. SHIPROCKET LOGISTICS & SHIPPING
# -------------------------------------------------------
# Your Shiprocket login credentials from https://app.shiprocket.in/
SHIPROCKET_EMAIL=shipping@hopekraft.in
SHIPROCKET_PASSWORD=YourShiprocketPassword
# Primary pickup warehouse pincode for calculating courier rates and pickup scheduling
SHIPROCKET_PICKUP_PINCODE=560038

# -------------------------------------------------------
# 4. APP URL (For callbacks & receipts)
# -------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
